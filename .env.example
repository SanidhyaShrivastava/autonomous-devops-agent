# Browser connection. Vercel's combined build writes this automatically.
NEXT_PUBLIC_CONVEX_URL=

# Vercel production server. CONVEX_URL is the same production deployment URL.
# DEMO_REQUEST_SECRET must match Convex production.
CONVEX_URL=
DEMO_REQUEST_SECRET=
PUBLIC_APP_URL=

# Vercel production build only. Create a production deployment key in Convex.
CONVEX_DEPLOY_KEY=

# Trusted local runner only. RUNNER_TOKEN must match Convex production.
# Never expose either value through a NEXT_PUBLIC_ variable.
RUNNER_TOKEN=
RUNNER_ID=gx-local-runner
